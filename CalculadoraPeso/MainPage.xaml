<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculadoraPeso.MainPage"
             BackgroundColor="#EAF1F7">

    <ScrollView>
        <VerticalStackLayout Spacing="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="20">

            <Border Stroke="#B8C9DB"
                    StrokeThickness="2"
                    BackgroundColor="White"
                    Padding="25"
                    WidthRequest="300">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <Label Text="Calculadora de IMC"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0B3252"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,10" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Peso (kg)"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0B3252" />

                        <Entry x:Name="PesoEntry"
                               Placeholder="70"
                               Keyboard="Numeric"
                               TextColor="#333333"
                               BackgroundColor="#F7FAFC" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Altura (m)"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0B3252" />

                        <Entry x:Name="AlturaEntry"
                               Placeholder="1,75"
                               Keyboard="Numeric"
                               TextColor="#333333"
                               BackgroundColor="#F7FAFC" />
                    </VerticalStackLayout>

                    <Button Text="CALCULAR IMC"
                            Clicked="OnCalcularClicked"
                            BackgroundColor="#174193"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            Margin="0,10,0,10" />

                    <Label x:Name="ResultadoLabel"
                           Text=""
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#0B3252"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="CategoriaLabel"
                           Text=""
                           TextColor="#0B3252"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <Image x:Name="ImagenImage"
                           HeightRequest="120"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>